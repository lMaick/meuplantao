# Preencha apenas em .env.local; consulte README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publica canonica usada em metadata, checkout e callbacks de autenticacao.
# Em producao, NEXT_PUBLIC_SITE_URL ou NEXT_PUBLIC_APP_URL legado e obrigatorio.
# VERCEL_PROJECT_PRODUCTION_URL nao substitui a configuracao canonica.
# Preview usa VERCEL_URL, resolvida no servidor para aquele deployment.
# Somente desenvolvimento pode usar VERCEL_URL ou a URL padrao.
NEXT_PUBLIC_SITE_URL=https://meuplantao.pro
NEXT_PUBLIC_APP_URL=https://meuplantao.pro

# Offline CI/test defaults only; never put real credentials here.
TEST_SUPABASE_URL=http://localhost:54321
TEST_SUPABASE_ANON_KEY=ci-test-anon-key

# MAI-145 — CSP efetiva gradual (server-side, lida em next.config.ts).
# Sem a flag: somente Report-Only + coleta em /api/csp-report.
# Com CSP_ENFORCE=true: emite também Content-Security-Policy efetiva.
# Rollback = remover a flag e fazer redeploy (headers avaliados no build).
# CSP_ENFORCE=false

# MAI-138 — billing rate limit / IPN legado (server-side apenas, nunca no client).
# Produção: limitador sempre ligado; dev/teste exige BILLING_RATE_LIMIT_ENABLED=true.
# BILLING_RATE_LIMIT_DISABLED=true desliga em qualquer ambiente (emergência).
# BILLING_RATE_LIMIT_ENABLED=true
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Produção desabilita o IPN legado por padrão; true mantém temporariamente.
# MERCADO_PAGO_ENABLE_LEGACY_IPN=
